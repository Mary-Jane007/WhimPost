# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*.local
.env

# typescript
*.tsbuildinfo
next-env.d.ts

# database
/data/*.db
/data/*.db-*
# TV uploads are committed via Git LFS. Only ignore in-progress chunks.
/data/uploads/.incoming/
# Keep portable account snapshot (password hashes only) so logins
# work on fresh servers. Do not commit plaintext passwords.
!/data/persistent-accounts.json
# Keep TV Corner link catalog (YouTube / direct URLs) across fresh servers.
!/data/persistent-tv.json
# Keep uploaded TV file catalog (pairs with Git LFS objects under data/uploads/).
!/data/persistent-tv-media.json
# Keep Celestial Sounds catalog (Observatory playlist audio).
!/data/persistent-moon-sounds.json
/data/tv-cache/
/data/.media-release-staging/
/data/uploads/moon-sounds/
!/data/uploads/moon-sounds/.gitkeep

