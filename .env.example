# Copy to .env.local for local use, or paste into Render → Environment.

WHIMPOST_SECRET=replace-with-openssl-rand-hex-32
WHIMPOST_HTTPS=true
COOKIE_SECURE=true
PORT=3333

# Optional
# GH_TOKEN=
WHIMPOST_MEDIA_RELEASE_TAG=whimpost-media
WHIMPOST_TV_AUTOPUSH=1

# IMPORTANT for Render:
# Do NOT set NODE_ENV=production yourself.
# Render sets it at runtime. If you set it during install/build,
# npm skips build tools and you get "Build failed because of webpack errors"
# (Cannot find module 'tailwindcss').
